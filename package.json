{
  "name": "cloudflare-workers-openapi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "check": "ultracite check",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "fix": "ultracite fix",
    "migrate:dev": "drizzle-kit generate && wrangler d1 migrations apply DB --local",
    "migrate:prod": "drizzle-kit generate && wrangler d1 migrations apply DB --remote",
    "seed:dev": "wrangler d1 execute DB --local --file scripts/seed-locations.sql",
    "seed:prod": "wrangler d1 execute DB --remote --file scripts/seed-locations.sql",
    "start": "wrangler dev --ip 0.0.0.0",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.5",
    "better-auth": "^1.7.5",
    "chanfana": "^3.3.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.12",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.6",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsx": "^4.23.13",
    "ultracite": "^7.12.0",
    "wrangler": "^4.131.2"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260911.1": true
  }
}
