{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "linter": {
    "rules": {
      "suspicious": {
        "useAwait": "off"
      },
      "correctness": {
        "useImageSize": "off"
      },
      "a11y": {
        "useAnchorContent": "off"
      },
      "performance": {
        "noNamespaceImport": "off"
      }
    }
  }
}
